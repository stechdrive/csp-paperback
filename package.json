{
  "name": "csp-paperback",
  "private": true,
  "version": "1.33.290",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run version:sync",
    "build": "tsc -b && vite build",
    "prebuild:tauri": "npm run version:sync",
    "build:tauri": "tsc -b && vite build --base ./",
    "audit:artifacts": "node scripts/audit-artifacts.mjs",
    "generate:testdata:collision": "node scripts/generate-collision-fixture.mjs",
    "generate:testdata:context-pruning": "node scripts/generate-context-pruning-fixture.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "pretauri:build": "npm run version:sync",
    "tauri:build": "node scripts/tauri-build-with-remap.mjs",
    "version:check": "node scripts/sync-build-version.mjs --check",
    "version:sync": "node scripts/sync-build-version.mjs",
    "test": "vitest",
    "test:run": "vitest run --sequence.shuffle --sequence.seed=2307",
    "test:coverage": "vitest run --coverage --sequence.shuffle --sequence.seed=2307",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "test:e2e:built": "playwright test",
    "test:deploy": "node --test scripts/test-deploy-pages.mjs",
    "test:ui": "vitest --ui",
    "check": "npm run lint && npm run test:deploy && npm run test:run && npm run build",
    "check:ci": "npm run lint && npm run test:deploy && npm run test:coverage && npm run build && npm run test:e2e:built",
    "predeploy": "npm run build && npm run audit:artifacts -- dist",
    "deploy": "node scripts/deploy-pages.mjs --publish"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "ag-psd": "^31.0.3",
    "client-zip": "^2.5.1",
    "pako": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "^1.15.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.0.13",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-canvas-mock": "^1.2.0"
  },
  "engines": {
    "node": "^26.12.1"
  }
}
